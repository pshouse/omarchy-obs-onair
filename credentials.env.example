# OBS On Air viewer counts. Copy to ~/.config/obs-onair/credentials.env and chmod 600.
# Leave a platform's values empty to skip it.

# YouTube: Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=
# Channel ID (starts with UC): YouTube Studio → Settings → Channel → Advanced settings.
YOUTUBE_CHANNEL_ID=

# Twitch: dev.twitch.tv/console → Register Application → Client ID + New Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Your Twitch username (lowercase).
TWITCH_LOGIN=
